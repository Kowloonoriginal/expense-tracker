# Database
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker?schema=public"

# JWT
# Deliberately too short to pass validation — the app refuses to boot until
# you replace it. Generate a real one with: openssl rand -base64 48
JWT_SECRET="REPLACE_ME"
JWT_EXPIRES_IN="7d"

# Tests — e2e uses a separate database, see apps/backend/test/.env.test
# DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker_test?schema=public"

# Rate limiting reads the request's IP address. Leave unset for local dev and
# any deployment with no reverse proxy in front — only set to "1" once a proxy
# (Nginx, a cloud load balancer, ...) sits in front AND is confirmed to strip
# any client-supplied X-Forwarded-For header. Enabling it without that proxy
# lets a client set its own IP per request and bypass every rate limit.
# TRUST_PROXY="1"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
